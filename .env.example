# LLM Provider: anthropic | openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# DNIF API
DNIF_API_ENABLED=true
DNIF_CONSOLE_DOMAIN=your_console_domain_here
DNIF_CLUSTER_ID=your_cluster_id_here
DNIF_API_TOKEN=your_api_token_here
DNIF_SCOPE_ID=your_scope_id_here
DNIF_TIMEZONE=Asia/Kolkata
DNIF_POLL_INTERVAL=5
DNIF_MAX_WAIT_TIME=180

# Paths
KB_PATH=../copilot-poc/kb
PROMPTS_PATH=../copilot-poc/prompts
